          "role": "redScore",
          "min": 0,
          "max": 999,
          "hint": "From the field screen after the match. Leave empty if you didn’t see it."
        },
        {
          "id": "blueScore",
          "type": "number",
          "label": "Blue final score",
          "role": "blueScore",
          "min": 0,
          "max": 999
        },
        {
          "id": "driverSkill",
          "type": "rating",
          "label": "Driver skill",
          "min": 1,
          "max": 4,
          "labels": [
            "Weak",
            "OK",
            "Good",
            "Great"
          ]
        },
        {
          "id": "broke",
          "type": "toggle",
          "label": "Robot broke or stopped moving"
        },
        {
          "id": "minorFouls",
          "type": "counter",
          "label": "Minor fouls caused"
        },
        {
          "id": "majorFouls",
          "type": "counter",
          "label": "Major fouls caused"
        },
        {
          "id": "card",
          "type": "choice",
          "label": "Card received",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "yellow",
              "label": "Yellow",
              "color": "yellow"
            },
            {
              "value": "red",
              "label": "Red",
              "color": "red"
            }
          ]
        },
        {
          "id": "notes",
          "type": "notes",
          "label": "Notes"
        }
      ]
    }
  ]
