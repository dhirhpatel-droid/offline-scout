{
  "id": "ftc-2026-biobuzz",
  "version": 7,
  "program": "FTC",
  "season": "2026–27",
  "game": "BIOBUZZ",
  "alliance": {
    "colors": [
      "red",
      "blue"
    ],
    "robotsPerAlliance": 2
  },
  "notes": "FLOWERS score only in the last minute (G410), so FLOWER scoring is on the Endgame tab (1:00). FLOWER ownership is alliance-level: scouts count only this robot's pieces that ended in a FLOWER its alliance owns, and its Bottom NECTAR bonuses. Fouls give points to the other alliance, so they are recorded but not taken off.",
  "sections": [
    {
      "id": "pre",
      "label": "Setup",
      "title": "Setup",
      "fields": [
        {
          "id": "scout",
          "type": "text",
          "label": "Scout",
          "role": "scoutName",
          "required": true,
          "hidden": true
        },
        {
          "id": "level",
          "type": "choice",
          "label": "Match level",
          "role": "matchLevel",
          "required": true,
          "width": "half",
          "options": [
            {
              "value": "qual",
              "label": "Qual"
            },
            {
              "value": "playoff",
              "label": "Playoff"
            }
          ]
        },
        {
          "id": "match",
          "type": "number",
          "label": "Match number",
          "role": "matchNumber",
          "required": true
        },
        {
          "id": "team",
          "type": "number",
          "label": "Team number",
          "role": "teamNumber",
          "required": true,
          "width": "full",
          "hint": "From the match schedule, or the number on the robot"
        },
        {
          "id": "position",
          "type": "position",
          "label": "Alliance position",
          "role": "alliancePosition",
          "required": true
        },
        {
          "id": "noShow",
          "type": "toggle",
          "label": "Robot didn’t show up",
          "role": "noShow"
        }
      ]
    },
    {
      "id": "auto",
      "label": "Auto",
      "title": "Auto",
      "durationSec": 30,
      "fields": [
        {
          "id": "leave",
          "type": "toggle",
          "label": "LEAVE",
          "points": 3
        },
        {
          "id": "hiveTips",
          "type": "counter",
          "label": "HIVE TIPs",
          "points": 20
        },
        {
          "id": "park",
          "type": "toggle",
          "label": "PARK in loading zone",
          "points": 5,
          "hint": "At the end of Auto"
        },
        {
          "id": "notes",
          "type": "notes",
          "label": "Auto notes",
          "hint": "What they tried, where they scored, anything odd."
        }
      ]
    },
    {
      "id": "teleop",
      "label": "Teleop",
      "title": "Teleop",
      "durationSec": 120,
      "note": "Each row counts POLLEN and NECTAR together.",
      "fields": [
        {
          "id": "hiveTips",
          "type": "counter",
          "label": "HIVE TIPs",
          "points": 20
        },
        {
          "id": "garden",
          "type": "counter",
          "label": "Into a GARDEN",
          "points": 1
        },
        {
          "id": "cell",
          "type": "counter",
          "label": "Into a CELL",
          "points": 2
        },
        {
          "id": "defense",
          "type": "choice",
          "label": "Played defense",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "some",
              "label": "Some"
            },
            {
              "value": "heavy",
              "label": "A lot"
            }
          ]
        },
        {
          "id": "notes",
          "type": "notes",
          "label": "Teleop notes",
          "hint": "What they tried, where they scored, anything odd."
        }
      ]
    },
    {
      "id": "end",
      "label": "Endgame",
      "title": "Endgame",
      "fields": [
        {
          "id": "flower",
          "type": "counter",
          "label": "Into an owned FLOWER",
          "points": 2,
          "hint": "POLLEN or NECTAR, where your NECTAR ends on top"
        },
        {
          "id": "bottomNectar",
          "type": "counter",
          "label": "Bottom NECTAR",
          "points": 5,
          "max": 4,
          "hint": "Its NECTAR is the lowest in a FLOWER"
        },
        {
          "id": "park",
          "type": "toggle",
          "label": "PARK at the end",
          "points": 5,
          "hint": "In the loading zone when the match ends"
        }
      ],
      "durationSec": 60,
      "shortLabel": "End",
      "note": "The last minute of Teleop (part of its 2:00). FLOWERS only score now."
    },
    {
      "id": "post",
      "label": "After",
      "title": "After the match",
      "fields": [
        {
          "id": "redScore",
          "type": "number",
