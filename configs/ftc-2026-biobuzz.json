{
  "id": "ftc-2026-biobuzz",
  "version": 1,
  "program": "FTC",
  "season": "2026–27",
  "game": "BIOBUZZ",
  "alliance": { "colors": ["red", "blue"], "robotsPerAlliance": 2 },
  "notes": "Flower ownership and the bottom-nectar bonus are scored per alliance, not per robot, so they are not scouted here.",
  "sections": [
    {
      "id": "pre",
      "label": "Pre",
      "title": "Pre-match",
      "fields": [
        { "id": "scout", "type": "text", "label": "Scout name", "role": "scoutName", "required": true },
        { "id": "match", "type": "number", "label": "Match number", "role": "matchNumber", "required": true },
        { "id": "team", "type": "number", "label": "Team number", "role": "teamNumber", "required": true },
        {
          "id": "alliance", "type": "choice", "label": "Alliance", "role": "alliance", "required": true,
          "options": [ { "value": "red", "label": "Red" }, { "value": "blue", "label": "Blue" } ]
        },
        { "id": "noShow", "type": "toggle", "label": "Robot no-show", "role": "noShow" }
      ]
    },
    {
      "id": "auto",
      "label": "Auto",
      "title": "Auto",
      "durationSec": 30,
      "fields": [
        { "id": "leave", "type": "toggle", "label": "LEAVE", "points": 3 },
        { "id": "hiveTips", "type": "counter", "label": "HIVE TIPs", "points": 20 },
        { "id": "park", "type": "toggle", "label": "PARK in loading zone", "points": 5 }
      ]
    },
    {
      "id": "teleop",
      "label": "Teleop",
      "title": "Teleop",
      "durationSec": 120,
      "fields": [
        { "id": "hiveTips", "type": "counter", "label": "HIVE TIPs", "points": 20 },
        { "id": "flower", "type": "counter", "label": "Into a FLOWER", "hint": "POLLEN or NECTAR", "points": 2 },
        { "id": "garden", "type": "counter", "label": "Into a GARDEN", "hint": "POLLEN or NECTAR", "points": 1 },
        { "id": "cell", "type": "counter", "label": "Into a CELL", "hint": "POLLEN or NECTAR", "points": 2 },
        {
          "id": "defense", "type": "choice", "label": "Defense played",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "some", "label": "Some" },
            { "value": "heavy", "label": "Heavy" }
          ]
        }
      ]
    },
    {
      "id": "end",
      "label": "End",
      "title": "End game",
      "fields": [
        { "id": "park", "type": "toggle", "label": "PARK in loading zone", "points": 5 }
      ]
    },
    {
      "id": "post",
      "label": "Post",
      "title": "Post-match",
      "fields": [
        { "id": "driverSkill", "type": "rating", "label": "Driver skill", "min": 1, "max": 5 },
        { "id": "broke", "type": "toggle", "label": "Robot broke or was disabled" },
        { "id": "minorFouls", "type": "counter", "label": "Minor fouls" },
        { "id": "majorFouls", "type": "counter", "label": "Major fouls" },
        {
          "id": "card", "type": "choice", "label": "Card",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "red", "label": "Red" }
          ]
        },
        { "id": "notes", "type": "notes", "label": "Notes" }
      ]
    }
  ]
}
